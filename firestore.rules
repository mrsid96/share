rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verify user is anonymously authenticated or logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Temporary sharing rooms tree
    // Note: Absolutely zero file data or chunks are stored in Firestore.
    // Firestore is used exclusively for ephemeral room presence and WebRTC SDP/ICE signaling.
    match /rooms/{roomId} {
      allow read, write: if isAuthenticated();

      match /members/{uid} {
        allow read, write: if isAuthenticated();
      }

      match /connections/{connectionId} {
        allow read, write: if isAuthenticated();

        match /initiatorCandidates/{candidateId} {
          allow read, write: if isAuthenticated();
        }

        match /recipientCandidates/{candidateId} {
          allow read, write: if isAuthenticated();
        }
      }
    }

    // Deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
