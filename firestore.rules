rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Rooms ─────────────────────────────────────────────────────────────────

    match /rooms/{roomId} {
      // Room ID is a 128-bit secret token. Any authenticated user with the ID can access room metadata.
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.status == 'active';

      allow update, delete: if isAuthenticated() &&
        request.auth.uid == resource.data.hostUid;

      // ── Members ─────────────────────────────────────────────────────────────

      match /members/{uid} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() &&
          uid == request.auth.uid;
      }

      // ── Connections (Signaling) ──────────────────────────────────────────────

      match /connections/{connectionId} {
        // Any authenticated participant in this room can read connections targeting them
        allow read: if isAuthenticated();

        allow create: if isAuthenticated() &&
          request.resource.data.initiatorUid == request.auth.uid;

        allow update: if isAuthenticated() && (
          request.auth.uid == resource.data.recipientUid ||
          request.auth.uid == resource.data.initiatorUid
        );

        allow delete: if isAuthenticated();

        // ── ICE Candidates ───────────────────────────────────────────────────

        match /initiatorCandidates/{candidateId} {
          allow read, write: if isAuthenticated();
        }

        match /recipientCandidates/{candidateId} {
          allow read, write: if isAuthenticated();
        }
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
